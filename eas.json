{
	"cli": {
		"version": ">= 16.0.0",
		"appVersionSource": "remote"
	},
	"build": {
		"base": {
			"node": "22.22.1"
		},
		"development": {
			"extends": "base",
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"extends": "base",
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"extends": "base",
			"distribution": "store",
			"autoIncrement": true,
			"android": {
				"buildType": "app-bundle"
			}
		}
	}
}
